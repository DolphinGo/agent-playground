# Tavily API 配置
TAVILY_API_KEY=

# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# ReactAgent 配置
REACT_AGENT_MODEL=deepseek-flash
REACT_AGENT_MAX_STEPS=5
REACT_AGENT_LLM_TEMPERATURE=0.3
REACT_AGENT_THINKING=disabled

# PlanAndSolveAgent 配置
PLANNER_MODEL=deepseek-flash
PLANNER_LLM_TEMPERATURE=0.3
PLANNER_THINKING=disabled
PLANNER_MAX_STEPS=3
EXECUTOR_MODEL=deepseek-flash
EXECUTOR_LLM_TEMPERATURE=0.3
EXECUTOR_THINKING=disabled

# ReflectionAgent 配置
REFLECTION_EXECUTOR_MODEL=deepseek-flash
REFLECTION_EXECUTOR_LLM_TEMPERATURE=0.3
REFLECTION_EXECUTOR_THINKING=disabled
REFLECTION_REVIEWER_MODEL=deepseek-flash
REFLECTION_REVIEWER_LLM_TEMPERATURE=0.3
REFLECTION_REVIEWER_THINKING=disabled
REFLECTION_MAX_ITERATIONS=3

----------------------------------------

# Agent基类中处理跨会话记忆
MEMORY_MODEL=deepseek-flash
MEMORY_LLM_THINKING=disabled
MEMORY_CHUNK_SIZE=250
MEMORY_CHUNK_OVERLAP=50
MEMORY_QUERY_RESULTS=3
MEMORY_REUSE_THRESHOLD=0.8

# ChatAgent 配置
CHAT_AGENT_MODEL=deepseek-flash
CHAT_AGENT_LLM_TEMPERATURE=0.3
CHAT_AGENT_THINKING=disabled
MAX_HISTORY_TOKENS=4000

# Bge Embeddings 配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Rag Rerank
RAG_RERANK_API_KEY=
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_SIZE=250
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=10
RAG_TOP_N=3
